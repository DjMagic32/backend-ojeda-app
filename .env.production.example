# Copia este archivo como .env.production y reemplaza todos los valores.
# No lo subas al repositorio.
DOMAIN=api.ejemplo.com
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_MIGRATION_ENDPOINT_KEY=
DJANGO_ALLOWED_HOSTS=api.ejemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.ejemplo.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SERVE_API_DOCS=False
DJANGO_SERVE_MEDIA=False
DJANGO_TIME_ZONE=America/Caracas

POSTGRES_DB=tuplaza
POSTGRES_USER=tuplaza_app
POSTGRES_PASSWORD=genera-otra-clave-larga-y-aleatoria

# En Docker Compose de producción se establece automáticamente como
# redis://redis:6379/0. No usar redis://localhost dentro del contenedor web.
REDIS_URL=redis://redis:6379/0

# Correo transaccional. Preferido: Resend por HTTPS.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=TuPlaza <no-reply@tuplaza.app>

# Alternativa a Resend: SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Almacenamiento de imágenes/documentos. Puede ser AWS S3, Cloudflare R2 u
# otro proveedor compatible con S3. Si se dejan vacías, se usa ./media local.
S3_MEDIA_ENABLED=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600
AWS_MEDIA_LOCATION=media

# Opcionales según las funciones que utilices.
GOOGLE_WEB_CLIENT_ID=
MAPBOX_TOKEN=
PHOTON_API_URL=https://photon.komoot.io
