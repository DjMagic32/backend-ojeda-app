# Copia este archivo como .env.production y reemplaza todos los valores.
# No lo subas al repositorio.
DOMAIN=api.ejemplo.com
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_MIGRATION_ENDPOINT_KEY=
DJANGO_ALLOWED_HOSTS=api.ejemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.ejemplo.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SERVE_API_DOCS=False
DJANGO_SERVE_MEDIA=False
DJANGO_TIME_ZONE=America/Caracas

POSTGRES_DB=tuplaza
POSTGRES_USER=tuplaza_app
POSTGRES_PASSWORD=genera-otra-clave-larga-y-aleatoria

# Opcionales según las funciones que utilices.
REDIS_URL=
GOOGLE_WEB_CLIENT_ID=
MAPBOX_TOKEN=
PHOTON_API_URL=https://photon.komoot.io
